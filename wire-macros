function VisualSearchInDirection (direction) abort
  let l:move = g:directions[a:direction][1]
  echom l:move
  execute ("normal! \<C-V>" . l:move)
  call HighlightPosWire(CursorPos())
  while GetChar(CursorPos()) != 'L'
    execute ("normal! " . l:move)
    call HighlightPosWire(CursorPos())
  endwhile
  normal! o
endfunction

